# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:8080
CUSTOMER_OWNER_URL=http://localhost:8080
RESELLER_FRONTEND_URL=http://localhost:8081
ADMIN_FRONTEND_URL=http://localhost:8082
APP_BASE_URL=http://localhost:4000
PUBLIC_BASE_URL=https://your-public-tunnel-or-domain.example.com

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/chatflow

# Auth
JWT_EXPIRATION=30d
USER_JWT_EXPIRATION=15d
JWT_SECRET=replace_with_long_random_admin_jwt_secret
USER_JWT_SECRET=replace_with_long_random_user_jwt_secret
SERVICE_TOKEN_SECRET=replace_with_long_random_service_token_secret

# Email (Nodemailer)
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-app-password

# Meta / WhatsApp Cloud API
META_BASE_URL=https://graph.facebook.com
META_API_VERSION=v19.0
META_APP_ID=your_meta_app_id
APP_SECRET=your_meta_app_secret
META_WABA_ID=your_whatsapp_business_account_id
PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_or_system_user_access_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
META_REDIRECT_URI=https://your-public-tunnel-or-domain.example.com/whatsapp/connect/callback

# Local WhatsApp OTP helpers
# When true, OTP is logged in backend console and returned in API response for local testing
WHATSAPP_OTP_DEBUG=true

# Plan defaults
DEFAULT_MAX_TEMPLATES=5

# Redis (BullMQ queues + Socket.IO)
REDIS_URL=redis://127.0.0.1:6379
